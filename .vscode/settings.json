{
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=${workspaceFolder}/build/debug-win32-x64-ninja",
    "--header-insertion=iwyu",
    "--completion-style=detailed",
    "--clang-tidy"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "cmake.buildDirectory": "${workspaceFolder}/build/debug-win32-x64-ninja",
  "cmake.configureOnOpen": false,
  "files.associations": {
    "*.tpp": "cpp",
    "*.ipp": "cpp"
  }
}
